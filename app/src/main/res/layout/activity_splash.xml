<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Container Utama -->
    <LinearLayout
        android:id="@+id/centerContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.50">

        <!-- LOGO CARD PUTIH BERSIH -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLogo"
            android:layout_width="164dp"
            android:layout_height="164dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="38dp"
            app:cardElevation="12dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1.5dp">

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="WestBuild Logo"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/wbni" />
        </com.google.android.material.card.MaterialCardView>

        <!-- NAMA TOKO -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/fraunces"
            android:letterSpacing="0.04"
            android:text="WestBuild"
            android:textColor="#0F172A"
            android:textSize="36sp"
            android:textStyle="bold" />

        <!-- AKSEN GARIS PEMBATAS BIRU ROYAL -->
        <View
            android:layout_width="56dp"
            android:layout_height="3.5dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:background="#0038A8" />

        <!-- TAGLINE / SUBTITLE -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fraunces"
            android:letterSpacing="0.14"
            android:text="HARDWARE &amp; BUILDING SUPPLIES"
            android:textColor="#475569"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- CONTAINER BAWAH UNTUK LOADING -->
    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="#0038A8"
            app:trackColor="#E2E8F0"
            app:trackCornerRadius="4dp"
            app:trackThickness="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/fraunces"
            android:letterSpacing="0.05"
            android:text="Loading application..."
            android:textColor="#64748B"
            android:textSize="11sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>