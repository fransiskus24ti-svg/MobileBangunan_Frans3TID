<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:padding="12dp"
    android:layout_marginBottom="1dp">


    <ImageView
        android:id="@+id/ivAvatarChat"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="#E3F2FD"
        android:padding="10dp"
        android:src="@drawable/ic_profile"
        app:tint="#0D47A1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />


    <LinearLayout
        android:id="@+id/layoutNama"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toEndOf="@+id/ivAvatarChat"
        app:layout_constraintEnd_toStartOf="@+id/tvWaktuChat"
        app:layout_constraintTop_toTopOf="@+id/ivAvatarChat">

        <TextView
            android:id="@+id/tvNamaChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TB Jaya Mandiri"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvLabelPusat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="#E3F2FD"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Pusat"
            android:textColor="#0D47A1"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>


    <TextView
        android:id="@+id/tvPesanTerakhir"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Siap Pak, armada dump truk siap diberangkatkan"
        android:textColor="#757575"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@+id/layoutNama"
        app:layout_constraintEnd_toStartOf="@+id/tvWaktuChat"
        app:layout_constraintTop_toBottomOf="@+id/layoutNama" />


    <TextView
        android:id="@+id/tvWaktuChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10:21"
        android:textColor="#9E9E9E"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/layoutNama" />


    <TextView
        android:id="@+id/tvBadgeChat"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_badge"
        android:gravity="center"
        android:text="2"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvWaktuChat"
        app:layout_constraintBottom_toBottomOf="@+id/ivAvatarChat" />

</androidx.constraintlayout.widget.ConstraintLayout>