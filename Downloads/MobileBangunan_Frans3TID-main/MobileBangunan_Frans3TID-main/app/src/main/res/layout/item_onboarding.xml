<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="180dp"
        android:layout_height="180dp"
        app:cardBackgroundColor="#1C2541"
        app:cardCornerRadius="90dp"
        app:cardElevation="8dp"
        app:strokeColor="#6FFFE9"
        app:strokeWidth="2dp">

        <ImageView
            android:id="@+id/ivOnboard"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:src="@drawable/bgunanni"
            app:tint="#6FFFE9" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvOnboardTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Judul Fitur"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvOnboardDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="4dp"
        android:text="Deskripsi singkat fitur toko bangunan."
        android:textAlignment="center"
        android:textColor="#5BC0BE"
        android:textSize="14sp" />
</LinearLayout>